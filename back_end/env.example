DB_PORT=<the database connection port>
DB_USER_NAME=<the database user name>
DB_PASSWORD=<the database password>
DB_NAME=<the database name>
DB_URL=<the base url of the db ex: localhost>


### MinIO admin credentials

# root (admin) credentials, applied to the MinIO server on first initialization of its data dir
MINIO_USER_NAME=<the minio server user name>
MINIO_PASSWORD=<the minio server user password>

# s3 back end user credentials, the minio-init bootstrap container creates the
# "back-end" MinIO user (with the readwrite policy) from these values on every up
S3_BACK_END_ACCESS_KEY=<the s3 back end user access key> 
S3_BACK_END_SECRET_KEY=<the s3 back end user secret key> 
S3_ENDPOINT_URL=<the url to the s3 endpoint>


### Social sign-in

# Google OAuth 2.0 web client. Authorized redirect URI:
# http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>

# Facebook login app. Valid OAuth redirect URI:
# http://localhost:8080/login/oauth2/code/facebook
FACEBOOK_CLIENT_ID=<facebook app id>
FACEBOOK_CLIENT_SECRET=<facebook app secret>
FACEBOOK_GRAPH_VERSION=v23.0

# public base URL used to build the provider redirect URIs
OAUTH2_REDIRECT_BASE_URL=http://localhost:8080

# frontend route that reads the tokens/error from the fragment after sign-in
APP_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# comma-separated emails that get the ADMIN role on first sign-in
BOOTSTRAP_ADMIN_EMAILS=

# locally issued JWT signing material; use a long random value in production
JWT_SECRET=<at least 32 random characters>
JWT_ACCESS_TTL=PT1H
JWT_REFRESH_TTL=P30D
JWT_ISSUER=club-management-system
JWT_AUDIENCE=club-management-system-api
